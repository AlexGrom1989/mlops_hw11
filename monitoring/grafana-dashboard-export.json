     "y": 0
    },
    "targets": [
     {
      "expr": "histogram_quantile(0.95, sum by (le) (rate(sim_ttfc_seconds_bucket[1m])))",
      "legendFormat": "p95"
     },
     {
      "expr": "histogram_quantile(0.50, sum by (le) (rate(sim_ttfc_seconds_bucket[1m])))",
      "legendFormat": "p50"
     }
    ],
    "title": "TTFC p50/p95 (гистограмма, PromQL classic)",
    "type": "timeseries"
   },
   {
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 12,
     "y": 0
    },
    "targets": [
     {
      "expr": "histogram_quantile(0.95, sum by (le) (rate(sim_full_seconds_bucket[1m])))",
      "legendFormat": "p95"
     }
    ],
    "title": "Полный ответ p95",
    "type": "timeseries"
   },
   {
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 0,
     "y": 8
    },
    "targets": [
     {
      "expr": "sum by (pod) (sim_running)",
      "legendFormat": "running {{pod}}"
     },
     {
      "expr": "sum by (pod) (sim_waiting)",
      "legendFormat": "waiting {{pod}}"
     }
    ],
    "title": "running/waiting по Pod",
    "type": "timeseries"
   },
   {
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 12,
     "y": 8
    },
    "targets": [
     {
      "expr": "sum(rate(sim_requests_total{outcome=\"ok\"}[1m]))",
      "legendFormat": "ok/с"
     },
     {
      "expr": "sum(rate(sim_requests_total{outcome=\"rejected\"}[1m]))",
      "legendFormat": "rejected/с"
     },
     {
      "expr": "sum(rate(sim_requests_total{outcome=\"interrupted\"}[1m]))",
      "legendFormat": "interrupted/с"
     }
    ],
    "title": "Завершённые/с и ошибки",
    "type": "timeseries"
   },
   {
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 0,
     "y": 16
    },
    "targets": [
     {
      "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"hw11-service.*\",container!=\"\"}[1m]))",
      "legendFormat": "cpu {{pod}}"
     },
     {
      "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"hw11-service.*\",container!=\"\"})",
      "legendFormat": "ram {{pod}}"
     }
    ],
    "title": "CPU и RAM подов сервиса",
    "type": "timeseries"
   },
   {
    "gridPos": {
     "h": 8,
     "w": 6,
     "x": 12,
     "y": 16
    },
