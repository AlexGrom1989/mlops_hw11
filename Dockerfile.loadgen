FROM python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN pip install --no-cache-dir httpx==0.28.1
COPY scripts/loadgen.py /app/loadgen.py
# Аргументы прогона приходят env'ом LG_ARGS (манифест Job), поэтому CMD —
# через shell: python /app/loadgen.py $LG_ARGS
CMD ["sh", "-c", "exec python /app/loadgen.py $LG_ARGS"]
